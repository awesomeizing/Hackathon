# ==============================================================================
# VeilOps v2.4.0 · Environment Configuration
# ==============================================================================

# Regional SaaS Configuration
REGION=ap-south
PORT=8443
DASHBOARD_HTTP_PORT=8080
BIND_HOST=127.0.0.1

# ------------------------------------------------------------------------------
# Supabase Tier 2 Cloud Configuration (Optional)
# ------------------------------------------------------------------------------
# When configured, Tier 2 automatically syncs scrubbed metadata & incidents to
# Supabase PostgreSQL with Row-Level Security (RLS) and enables Realtime sync.
# If left empty, VeilOps gracefully uses its native local SQLite WAL fallback store.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ------------------------------------------------------------------------------
# Organizer Stream Ingestion (Optional)
# ------------------------------------------------------------------------------
ORGANIZER_STREAM_URL=
ORGANIZER_STREAM_KEY=
ORGANIZER_STREAM_PATH=
